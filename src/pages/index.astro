---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.published).valueOf() - new Date(a.data.published).valueOf())
  .slice(0, 5);
---

<Layout title="Yash Karthik" description="Essays and short stories by Yash Karthik." route="/">

  <main style="max-width: 860px; margin: 0 auto; padding: 48px 24px; flex: 1;">

    <section style="margin-bottom: 48px;">
      <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px;">
        <span style="color: var(--accent); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;">PROFILE</span>
        <span style="flex: 1; border-top: 1px solid var(--border); position: relative; top: -4px;"></span>
      </div>
      <h1 style="font-size: 22px; font-weight: 700; color: var(--text); margin-bottom: 16px; letter-spacing: -0.01em;">
        Yash Karthik
      </h1>
      <p style="color: var(--text-dim); max-width: 520px; line-height: 1.7;">
        Computer engineering student at Waterloo. Building a lithography tool at Waterloo Fab.
        Interested in hardware, compilers, and the web.
      </p>
    </section>

    <section style="margin-bottom: 48px;">
      <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px;">
        <span style="color: var(--accent); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;">NOW</span>
        <span style="flex: 1; border-top: 1px solid var(--border); position: relative; top: -4px;"></span>
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        {[
          ["Building", "a lithography tool at Waterloo Fab", "https://www.waterloofab.com/"],
          ["Learning", "PCB design, building gadgets"],
          ["Studying", "computer engineering at Waterloo", "https://ece.engineering/"],
        ].map(([verb, desc, href]) => (
          <div style="display: grid; grid-template-columns: 80px 1fr; gap: 16px;">
            <span style="color: var(--text-muted); text-align: right;">{verb}</span>
            <span>
              {href
                ? <a href={href} target="_blank" style="color: var(--text);">{desc}</a>
                : <span style="color: var(--text);">{desc}</span>
              }
            </span>
          </div>
        ))}
      </div>
    </section>

    <section style="margin-bottom: 48px;">
      <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px;">
        <span style="color: var(--accent); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;">PREVIOUSLY</span>
        <span style="flex: 1; border-top: 1px solid var(--border); position: relative; top: -4px;"></span>
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        {[
          ["shipped", "semi-viral web apps using AI APIs"],
          ["firmware", "for drones at UWARG", "https://www.uwarg.com/"],
          ["ran", "Linux on LEGO EV3"],
        ].map(([verb, desc, href]) => (
          <div style="display: grid; grid-template-columns: 80px 1fr; gap: 16px;">
            <span style="color: var(--text-muted); text-align: right;">{verb}</span>
            <span>
              {href
                ? <a href={href} target="_blank" style="color: var(--text);">{desc}</a>
                : <span style="color: var(--text);">{desc}</span>
              }
            </span>
          </div>
        ))}
      </div>
    </section>

    <section style="margin-bottom: 48px;">
      <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px;">
        <span style="color: var(--accent); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;">WRITING</span>
        <span style="flex: 1; border-top: 1px solid var(--border); position: relative; top: -4px;"></span>
      </div>
      <div style="display: flex; flex-direction: column;">
        {posts.map((post) => (
          <a
            href={`/archive/${post.slug}`}
            style="
              display: grid;
              grid-template-columns: 1fr auto;
              gap: 16px;
              padding: 8px 0;
              border-bottom: 1px solid var(--border);
              color: var(--text);
              transition: color 120ms;
            "
            onmouseover="this.style.color='var(--accent)'"
            onmouseout="this.style.color='var(--text)'"
          >
            <span>{post.data.title}</span>
            <span style="color: var(--text-muted); white-space: nowrap; font-size: 11px; align-self: center;">
              {new Date(post.data.published).getFullYear()}
            </span>
          </a>
        ))}
      </div>
      <div style="margin-top: 12px;">
        <a href="/archive" style="color: var(--text-muted); font-size: 11px; letter-spacing: 0.05em;">
          all posts →
        </a>
      </div>
    </section>

    <section style="margin-bottom: 48px;">
      <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px;">
        <span style="color: var(--accent); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;">LORE</span>
        <span style="flex: 1; border-top: 1px solid var(--border); position: relative; top: -4px;"></span>
      </div>
      <p style="color: var(--text-dim); max-width: 580px; line-height: 1.8; border-left: 2px solid var(--border); padding-left: 16px;">
        Five years ago I awoke in a strange new world: I learned to code. My friend and I were
        tasked with cleaning up the robotics lab after a late night session. Rather than spending
        hours sorting parts manually, we built a robot to do it. I knew how transformative
        technology is — but actually leveraging it to automate a mundane task was when I truly
        <span style="color: var(--text);">grokked</span> the power of technology. Since then I've built
        fast web apps, firmware for robots, slow VMs, and learned to embrace being a
        <span style="color: var(--text);">perpetual beginner</span>.
      </p>
    </section>

  </main>

</Layout>
