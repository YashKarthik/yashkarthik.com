---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from 'astro:content';

const blog = await getCollection('blog');
const weekly = await getCollection('weekly');
const stories = await getCollection('stories');

const allWriting = Array.from(new Set([blog[0], weekly[0], stories[0]].concat(blog, weekly, stories)));
allWriting.sort((a, b) => {
  return new Date(a.data.published) < new Date(b.data.published) ? 1 : -1;
});

let years: number[] = [];
for (let i = new Date().getFullYear(); i > 2020; i--) {
  years.push(i);
}
---

<Layout title="Writing" description="Archive of all essays written by Yash Karthik" route="/archive">
  <main style="max-width: 680px; margin: 0 auto; padding: 48px 24px; flex: 1;">

    <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 32px;">
      <span style="color: var(--accent); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;">WRITING</span>
      <span style="flex: 1; border-top: 1px solid var(--border); position: relative; top: -4px;"></span>
    </div>

    {years.map(year => {
      const items = allWriting.filter(w => new Date(w.data.published).getFullYear() === year);
      if (items.length === 0) return null;
      return (
        <section style="margin-bottom: 32px;">
          <div style="font-size: 11px; color: var(--text-muted); letter-spacing: 0.1em; margin-bottom: 12px;">{year}</div>
          <div style="display: flex; flex-direction: column;">
            {items.map(w => (
              <a
                href={
                  w.collection === "blog" ? `/archive/${w.slug}`
                  : w.collection === "stories" ? `/archive/stories/${w.slug}`
                  : `/archive/weekly/${w.slug}`
                }
                style="
                  display: grid;
                  grid-template-columns: 1fr auto;
                  gap: 16px;
                  padding: 8px 0;
                  border-bottom: 1px solid var(--border);
                  color: var(--text);
                  font-size: 12px;
                  transition: color 120ms;
                "
                onmouseover="this.style.color='var(--accent)'"
                onmouseout="this.style.color='var(--text)'"
              >
                <span>{w.data.title}</span>
                <span style="color: var(--text-muted); font-size: 11px; white-space: nowrap; align-self: center;">
                  {w.collection !== "blog" ? `[${w.collection}]` : ""}
                </span>
              </a>
            ))}
          </div>
        </section>
      );
    })}

  </main>
</Layout>
