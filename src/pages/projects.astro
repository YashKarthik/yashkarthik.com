---
import Layout from "../layouts/Layout.astro";
import ProjectsMasterComponent from "../components/ProjectsMaster.tsx";
---

<Layout title="Projects" description="Archive of recent projects by Yash Karthik" route="/projects">
  <main style="max-width: 1100px; margin: 0 auto; padding: 48px 24px; flex: 1;">

    <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 32px;">
      <span style="color: var(--accent); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;">PROJECTS</span>
      <span style="flex: 1; border-top: 1px solid var(--border); position: relative; top: -4px;"></span>
    </div>

    <ProjectsMasterComponent client:load />

  </main>
</Layout>
