---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Links" description="Where to find Yash on the internet." route="/links">
  <main style="max-width: 680px; margin: 0 auto; padding: 48px 24px; flex: 1;">

    <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 32px;">
      <span style="color: var(--accent); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;">LINKS</span>
      <span style="flex: 1; border-top: 1px solid var(--border); position: relative; top: -4px;"></span>
    </div>

    <div style="display: flex; flex-direction: column;">
      {[
        ["github", "github.com/yashkarthik", "https://github.com/yashkarthik"],
        ["twitter", "_yashkarthik", "https://twitter.com/_yashKarthik"],
        ["linkedin", "Yash Karthik", "https://www.linkedin.com/in/yashkarthik"],
        ["youtube", "yashkarthik", "https://www.youtube.com/channel/UCokxkaw1HSQKNJPDtJHhDkg"],
        ["farcaster", "yashkarthik", "https://www.discove.xyz/@yashkarthik"],
        ["nf.td", "nf.td/yashkarthik", "https://nf.td/yashkarthik"],
        ["buymeacoffee", "yashkarthik", "https://buymeacoffee.com/yashkarthik"],
        ["eth", "yashkarthik.eth", null],
      ].map(([platform, handle, href]) => (
        <div style="
          display: grid;
          grid-template-columns: 120px 1fr;
          gap: 24px;
          padding: 10px 0;
          border-bottom: 1px solid var(--border);
          align-items: center;
          font-size: 12px;
        ">
          <span style="color: var(--text-muted);">{platform}</span>
          {href
            ? (
              <a
                href={href}
                target="_blank"
                style="color: var(--text-dim);"
                onmouseover={(e) => (e.currentTarget as HTMLElement).style.color = "var(--accent)"}
                onmouseout={(e) => (e.currentTarget as HTMLElement).style.color = "var(--text-dim)"}
              >
                {handle}
              </a>
            )
            : <span style="color: var(--text-dim);">{handle}</span>
          }
        </div>
      ))}
    </div>

  </main>
</Layout>
