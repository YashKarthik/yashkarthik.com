---
const { title, image_url, description, route } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{title + " · yashkarthik.com"}</title>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description || "Yash Karthik's digital garden filled with essays on programming, physics and humans."} />
    <meta name="og:image" content={"https://www.yashkarthik.com/" + (image_url || "ogImage.png")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="robots" content="all" />
    <meta name="og:title" content={title + " | Yash Karthik"} />
    <meta name="og:description" content={description || "Yash Karthik's digital garden filled with essays on programming, physics and humans."} />
    <meta name="og:type" content="blog" />
    <meta name="og:url" content="https://www.yashkarthik.com" />
    <meta name="twitter:site" content="@_yashKarthik" />

    <slot name="head-metadata" />

    <style>
      @font-face {
        font-family: 'Geist Mono';
        src: url('/fonts/GeistMonoVariableVF.woff2') format('woff2');
        font-style: normal;
        font-display: swap;
      }

      :root {
        --bg: #0c0c0c;
        --bg-subtle: #141414;
        --border: #2a2a2a;
        --border-bright: #444;
        --text: #d4d4d4;
        --text-muted: #666;
        --text-dim: #888;
        --accent: #a3e635;
        --accent-dim: #4d6b19;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background: var(--bg);
        color: var(--text);
        font-family: 'Geist Mono', 'Menlo', 'Monaco', 'Courier New', monospace;
        font-size: 13px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      body {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      a:hover {
        color: var(--accent);
      }

      ::selection {
        background: var(--accent-dim);
        color: var(--accent);
      }

      hr {
        border: none;
        border-top: 1px solid var(--border);
      }

      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: var(--bg); }
      ::-webkit-scrollbar-thumb { background: var(--border-bright); }
    </style>
  </head>

  <body>
    <nav style="
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 24px;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      background: var(--bg);
      z-index: 100;
    ">
      <a href="/" style="color: var(--accent); font-weight: 700; letter-spacing: 0.05em;">
        YK
      </a>
      <div style="display: flex; gap: 24px;">
        {[
          ["~/", "/"],
          ["projects", "/projects"],
          ["writing", "/archive"],
          ["links", "/links"],
        ].map(([label, href]) => (
          <a
            href={href}
            style={`
              color: ${route === href || (href !== "/" && route?.startsWith(href)) ? "var(--accent)" : "var(--text-muted)"};
              transition: color 120ms;
            `}
          >
            {label}
          </a>
        ))}
      </div>
    </nav>

    <slot />

    <footer style="
      margin-top: auto;
      padding: 16px 24px;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--text-muted);
      font-size: 11px;
    ">
      <span>yashkarthik.com</span>
      <span>
        <a href="/rss.xml" style="color: var(--text-muted);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">rss</a>
        {" "}·{" "}
        <a href="https://socratica.info/" target="_blank" style="color: var(--text-muted);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">⁂</a>
      </span>
    </footer>
  </body>
</html>

<script>
  const rssCopyButton = document.querySelectorAll("button#rss-copy-button");
  rssCopyButton.forEach((r) => {
    r!.addEventListener("click", () => {
      navigator.clipboard.writeText("https://www.yashkarthik.com/rss.xml");
      r!.firstChild!.nodeValue = "copied!";
      setTimeout(() => {
        r!.firstChild!.nodeValue = "RSS";
      }, 1000);
    });
  });
</script>
