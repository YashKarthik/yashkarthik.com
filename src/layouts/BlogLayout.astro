---
import Layout from '../layouts/Layout.astro';
import type { CollectionEntry } from 'astro:content';

type Props = {
  frontmatter: CollectionEntry<"blog">["data"];
  githubSlug: string;
  nextSlug: string;
  prevSlug: string;
  nextTitle: string;
  prevTitle: string;
}

const {
  frontmatter,
  nextSlug, nextTitle,
  prevSlug, prevTitle
} = Astro.props;
---

<Layout {...frontmatter} route="/archive">

  <article style="max-width: 680px; margin: 0 auto; padding: 48px 24px; flex: 1;">

    <header style="margin-bottom: 40px; padding-bottom: 24px; border-bottom: 1px solid var(--border);">
      <div style="color: var(--text-muted); font-size: 11px; margin-bottom: 12px; display: flex; gap: 16px;">
        <span>
          <a href="/archive" style="color: var(--text-muted);">writing</a>
          {" / "}
          {frontmatter.title}
        </span>
      </div>
      <h1 style="font-size: 20px; font-weight: 700; color: var(--text); line-height: 1.4; margin-bottom: 8px;">
        {frontmatter.title}
      </h1>
      <time style="color: var(--text-muted); font-size: 11px;">{frontmatter.published}</time>
    </header>

    <div class="prose-content">
      <slot />
    </div>

    <footer style="margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--border);">
      <nav style="display: flex; justify-content: space-between; margin-bottom: 24px; font-size: 11px; gap: 16px;">
        <div>
          {prevSlug &&
            <a href={prevSlug} style="color: var(--text-muted); display: flex; gap: 6px; align-items: center;">
              <span>←</span>
              <span style="max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{prevTitle}</span>
            </a>
          }
        </div>
        <div style="text-align: right;">
          {nextSlug &&
            <a href={nextSlug} style="color: var(--text-muted); display: flex; gap: 6px; align-items: center; justify-content: flex-end;">
              <span style="max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{nextTitle}</span>
              <span>→</span>
            </a>
          }
        </div>
      </nav>
      <p style="color: var(--text-muted); font-size: 11px;">
        Have a comment? <a href="/links" style="color: var(--text-dim);">email me</a>.
      </p>
    </footer>

  </article>

</Layout>

<style is:global>
  .prose-content {
    color: var(--text-dim);
    line-height: 1.8;
  }

  .prose-content p {
    margin-bottom: 20px;
  }

  .prose-content h1,
  .prose-content h2,
  .prose-content h3,
  .prose-content h4 {
    color: var(--text);
    font-weight: 700;
    margin-top: 40px;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }

  .prose-content h1 { font-size: 18px; }
  .prose-content h2 { font-size: 16px; }
  .prose-content h3 { font-size: 14px; }

  .prose-content a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border-bright);
  }

  .prose-content a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent-dim);
  }

  .prose-content code {
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: 1px 5px;
    border-radius: 2px;
    color: var(--text);
  }

  .prose-content pre {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: 16px;
    overflow-x: auto;
    margin-bottom: 20px;
    font-size: 12px;
    line-height: 1.6;
  }

  .prose-content pre code {
    background: none;
    border: none;
    padding: 0;
  }

  .prose-content blockquote {
    border-left: 2px solid var(--border-bright);
    padding-left: 16px;
    color: var(--text-muted);
    margin: 20px 0;
    font-style: italic;
  }

  .prose-content ul,
  .prose-content ol {
    padding-left: 20px;
    margin-bottom: 20px;
  }

  .prose-content li {
    margin-bottom: 4px;
  }

  .prose-content img {
    max-width: 100%;
    border: 1px solid var(--border);
    margin: 24px 0;
  }

  .prose-content hr {
    margin: 40px 0;
  }

  .prose-content strong {
    color: var(--text);
    font-weight: 600;
  }

  .prose-content em {
    color: var(--text-dim);
  }

  .prose-content .astro-code {
    border: 1px solid var(--border) !important;
    border-radius: 0 !important;
  }
</style>
